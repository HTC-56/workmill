{
  "name": "workmill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant AI batch-work platform on your own hardware.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/workmill.js",
    "seed:demo": "node dist/bin/seed-demo.js",
    "reset:demo": "node dist/bin/reset-demo.js",
    "mint:token": "node dist/bin/mint-token.js",
    "verify": "bash verify.sh"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
